# Optional settings for Jersey HD Studio. Copy this file to ".env" and uncomment what you need.
#
# API KEYS DO NOT GO HERE. Paste them into these files in the project folder instead:
#   .openai_api_key      -> image generation (required for real images) + optional AI designer
#   .anthropic_api_key   -> optional AI designer using Claude
# Keys are read only from those files (never from environment variables or this file).

# --- Image generation ---
# JERSEY_DEFAULT_IMAGE_PROVIDER=auto          # auto | openai | mock
# JERSEY_OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst   # or gpt-image-2.5-flare (faster)
# JERSEY_ENABLE_MOCK_PROVIDER=false            # also offer the offline demo generator

# --- AI designer (expands the client's words into a detailed design brief) ---
# JERSEY_BRIEF_WRITER=auto                     # auto | claude | openai | off
# JERSEY_CLAUDE_MODEL=claude-opus-5-5
# JERSEY_CLAUDE_EFFORT=medium                  # low | medium | high | xhigh | max
# JERSEY_OPENAI_TEXT_MODEL=gpt-6.1-sol

# --- Access & limits ---
# JERSEY_APP_USERNAME=studio
# JERSEY_APP_PASSWORD=                         # set this before sharing the app with clients
# A second login that opens only the client demo page /customerep (and only the jobs made with it); off when empty:
# JERSEY_DEMO_USERNAME=demo
# JERSEY_DEMO_PASSWORD=
# On an online server behind HTTPS (Caddy): a Secure login cookie, the visitor's real address for the hourly limit,
# and one heavy image task at a time on a small (1 GB) server:
# JERSEY_COOKIE_SECURE=true
# JERSEY_TRUST_PROXY_HEADERS=true
# JERSEY_CPU_JOBS=1
# and make each panel job's print PNGs and detailed EPS in the background as soon as it is done:
# JERSEY_PREPARE_DOWNLOADS=true
# JERSEY_RATE_LIMIT_PER_HOUR=120               # generation requests per client per hour (0 = unlimited)
# JERSEY_MAX_UPLOAD_MB=20
# JERSEY_MAX_CONCURRENT_GENERATIONS=4
# JERSEY_PROVIDER_TIMEOUT_S=300
# JERSEY_PRINT_DPI=300
# JERSEY_TRUST_PROXY_HEADERS=false             # true only behind a reverse proxy you control
# JERSEY_OUTPUT_DIR=outputs
