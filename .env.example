# Optional settings for Jersey HD Studio. Copy this file to ".env" and uncomment what you need.
#
# API KEYS DO NOT GO HERE. Paste them into these files in the project folder instead:
#   .openai_api_key      -> image generation (required for real images) + optional AI designer
#   .anthropic_api_key   -> optional AI designer using Claude
# Keys are read only from those files (never from environment variables or this file).

# --- Image generation ---
# JERSEY_DEFAULT_IMAGE_PROVIDER=auto          # auto | openai | mock
# JERSEY_OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst   # or gpt-image-2.5-flare (faster)
# JERSEY_ENABLE_MOCK_PROVIDER=false            # also offer the offline demo generator

# --- AI designer (expands the client's words into a detailed design brief) ---
# JERSEY_BRIEF_WRITER=auto                     # auto | claude | openai | off
# JERSEY_CLAUDE_MODEL=claude-opus-5-5
# JERSEY_CLAUDE_EFFORT=medium                  # low | medium | high | xhigh | max
# JERSEY_OPENAI_TEXT_MODEL=gpt-6.1-sol

# --- Access & limits ---
# The head admin login (every page, the Dashboard, adding tokens):
# JERSEY_APP_USERNAME=studio
# JERSEY_APP_PASSWORD=                         # set this before sharing the app with clients
# A second login that opens only the client demo page /customerep (and only the jobs made with it); off when empty:
# JERSEY_DEMO_USERNAME=demo
# JERSEY_DEMO_PASSWORD=
# The partner login: only the Partner dashboard /partner-dashboard (each client's tokens; it checks bKash payments,
# adds tokens and adds customers; no costs, no settings); off when empty:
# JERSEY_PARTNER_USERNAME=partner
# JERSEY_PARTNER_PASSWORD=
# The tokens a customer made with the dashboards' Customer EntryPoint Builder starts with (0 = none).
# JERSEY_WELCOME_TOKENS=100
# On an online server behind HTTPS (Caddy): a Secure login cookie, the visitor's real address for the hourly limit,
# and one heavy image task at a time on a small (1 GB) server:
# JERSEY_COOKIE_SECURE=true
# JERSEY_TRUST_PROXY_HEADERS=true
# JERSEY_CPU_JOBS=1
# and make each panel job's print PNGs and detailed EPS in the background as soon as it is done:
# JERSEY_PREPARE_DOWNLOADS=true
# and delete such ready-made downloads (print-size panel PNGs, EPS/SVG/PDF exports) once they are this many days
# old, and the oldest of them whenever less than this many GB are free on the disk (0 = off for either). The AI
# images and the client's pictures are never deleted, so each file is made again on its next download:
# JERSEY_CLEANUP_DAYS=7
# JERSEY_CLEANUP_MIN_FREE_GB=2
# Turn off /panels (the head admin's panel page) and the main page's link to it:
# JERSEY_PANELS_PAGE=false
# The Dashboard counts nothing before this date (a date alone = midnight on this machine's clock); empty = all:
# JERSEY_DASHBOARD_SINCE=2026-11-08
# The client pages' folder (/client_<name>: each client's logo, colours and own login, and tokens.json with the token
# prices; kept out of git):
# JERSEY_CLIENT_ASSETS_DIR=client_assets
# One machine's Dashboard on another (app/sync.py). On the machine that sends (e.g. a laptop): the server's address,
# the shared secret, this machine's name there, and how often to send (it also sends on the Dashboard's button):
# JERSEY_SYNC_URL=https://your-server.example
# JERSEY_SYNC_TOKEN=                           # a long random secret, the same on both machines
# JERSEY_MACHINE_NAME=laptop                   # lower-case letters, digits, - and _ (the server itself: "server")
# JERSEY_SYNC_MINUTES=10
# On the machine that receives: JERSEY_SYNC_TOKEN alone (without it, /api/sync/report answers 404).
# JERSEY_RATE_LIMIT_PER_HOUR=120               # generation requests per client per hour (0 = unlimited)
# JERSEY_MAX_UPLOAD_MB=20
# JERSEY_MAX_CONCURRENT_GENERATIONS=4
# JERSEY_PROVIDER_TIMEOUT_S=300
# JERSEY_PRINT_DPI=300
# JERSEY_TRUST_PROXY_HEADERS=false             # true only behind a reverse proxy you control
# JERSEY_OUTPUT_DIR=outputs
